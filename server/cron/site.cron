# Generated by server/provision.sh for the @NAME@ instance: edit the template
# server/cron/site.cron, not /etc/cron.d/pipeinpipe-@NAME@.
# Run as www-data, which owns the page cache, locks and logs they write to.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Recompute the ratings of the last and next 5 days, so that corrected results
# show up (pages compute missing ratings on demand). Midnight UTC.
0 0 * * * www-data rm -rf @DATA@/temp/cache/api && php @PIPE_ROOT@/main/cron/cron_sport_rating.php >> @DATA@/logs/cron.log 2>&1

# Publish posts collected from VK and Twitter into the agg_* tables as site
# posts. Nothing has been collected since 2013, so it finds nothing to do.
*/5 * * * * www-data php @PIPE_ROOT@/main/cron/cron_crossposting.php >> @DATA@/logs/cron.log 2>&1
